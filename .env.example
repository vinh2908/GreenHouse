# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Green House
NODE_ENV=development
PORT=3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password
MONGO_DB_NAME=homemate
MONGODB_URI=mongodb://admin:password@localhost:27017/homemate?authSource=admin

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_URL=redis://:password@localhost:6379

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Change these in production!
JWT_ACCESS_SECRET=homemate-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=homemate-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# ─── Firebase (Phase 7 - Notifications) ─────────────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_AI_ASSISTANT=false
FEATURE_AI_IMAGE_ANALYSIS=false
FEATURE_MOCK_PAYMENT=true

# ─── Gọi thoại trong app — che số thật (Roadmap Phase 1) ─────────────────────
# Nhà cung cấp VoIP: stringee (mặc định). Để trống 2 biến Stringee = tính năng
# gọi bị tắt một cách an toàn: API trả enabled=false và app ẩn nút gọi.
# Lấy tại https://console.stringee.com → Project → API Key
# CALL_PROVIDER=stringee
# STRINGEE_API_KEY_SID=SK.0.auayLHCq4SvEhEHcCNOeUs8eHKwZYoDb
# STRINGEE_API_KEY_SECRET=ZzlCN25GbmJsMVdaTmZDbnBUdUJtWTVweG9heDRoaA==

# ─── Tranh chấp (Roadmap Phase 1) ────────────────────────────────────────────
# Số giờ được kháng cáo sau khi Admin ra phán quyết (mặc định 72)
# DISPUTE_APPEAL_WINDOW_HOURS=72
