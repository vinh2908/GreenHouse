{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/login" },
    { "source": "/(auth)/login", "destination": "/login" },
    { "source": "/register", "destination": "/register" },
    { "source": "/(auth)/register", "destination": "/register" },
    { "source": "/otp", "destination": "/otp" },
    { "source": "/(auth)/otp", "destination": "/otp" },
    { "source": "/select-role", "destination": "/select-role" },
    { "source": "/(auth)/select-role", "destination": "/select-role" },
    { "source": "/home", "destination": "/home" },
    { "source": "/(customer)/home", "destination": "/home" },
    { "source": "/booking", "destination": "/booking" },
    { "source": "/(customer)/booking", "destination": "/booking" },
    { "source": "/jobs", "destination": "/jobs" },
    { "source": "/(customer)/jobs", "destination": "/jobs" },
    { "source": "/messages", "destination": "/messages" },
    { "source": "/(customer)/messages", "destination": "/messages" },
    { "source": "/profile", "destination": "/profile" },
    { "source": "/(customer)/profile", "destination": "/profile.html" },
    { "source": "/dashboard", "destination": "/dashboard" },
    { "source": "/(helper)/dashboard", "destination": "/dashboard" },
    { "source": "/(helper)/jobs", "destination": "/jobs" },
    { "source": "/earnings", "destination": "/earnings" },
    { "source": "/(helper)/earnings", "destination": "/earnings" },
    { "source": "/(helper)/profile", "destination": "/profile" },
    { "source": "/kyc", "destination": "/kyc" },
    { "source": "/bank-account", "destination": "/bank-account" },
    { "source": "/help-center", "destination": "/help-center" },
    { "source": "/policy-insurance", "destination": "/policy-insurance" },
    { "source": "/sos", "destination": "/sos" },
    { "source": "/notifications", "destination": "/notifications" },
    { "source": "/edit-profile", "destination": "/edit-profile" },
    { "source": "/job-detail/:id", "destination": "/job-detail/%5Bid%5D" },
    { "source": "/helper-job-detail/:id", "destination": "/helper-job-detail/%5Bid%5D" },
    { "source": "/helper-profile/:id", "destination": "/helper-profile/%5Bid%5D" },
    { "source": "/sos-tracking/:id", "destination": "/sos-tracking/%5Bid%5D" },
    { "source": "/chat/:jobId", "destination": "/chat/%5BjobId%5D" },
    { "source": "/((?!_expo|assets|favicon.ico).*)", "destination": "/index" }
  ]
}
