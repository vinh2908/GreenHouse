{
  "expo": {
    "name": "Green House",
    "slug": "green-house",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "greenhouse",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22C55E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homemate.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Green House cần quyền truy cập vị trí để tìm dịch vụ và người giúp việc gần bạn.",
        "NSCameraUsageDescription": "Green House cần quyền truy cập camera để chụp ảnh công việc và xác thực e-KYC.",
        "NSPhotoLibraryUsageDescription": "Green House cần quyền truy cập thư viện ảnh để upload hình ảnh."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#22C55E"
      },
      "package": "com.homemate.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép Green House truy cập vị trí của bạn."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#22C55E"
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://192.168.2.248:3000/api/v1",
      "wsUrl": "http://192.168.2.248:3000",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
