{
  "expo": {
    "name": "Green House",
    "slug": "green-house",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "greenhouse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homemate.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Green House cần quyền truy cập vị trí để tìm dịch vụ và người giúp việc gần bạn.",
        "NSCameraUsageDescription": "Green House cần quyền truy cập camera để chụp ảnh công việc và xác thực e-KYC.",
        "NSPhotoLibraryUsageDescription": "Green House cần quyền truy cập thư viện ảnh để upload hình ảnh."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0FDF4"
      },
      "package": "com.homemate.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Green House",
      "shortName": "Green House",
      "themeColor": "#16A34A",
      "backgroundColor": "#F0FDF4",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "./plugins/with-callkeep.js",
      "./plugins/with-voip-background-mode.js",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép Green House truy cập vị trí của bạn kể cả khi ứng dụng đang chạy nền, để thợ chia sẻ hành trình đến khách hàng.",
          "locationWhenInUsePermission": "Green House cần vị trí của bạn để hiển thị bản đồ và tìm dịch vụ gần đây.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#22C55E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F0FDF4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00bd43d9-3219-4c63-85af-0964f8651091"
      }
    }
  }
}
