# ==============================================================================
# Homemate Mobile (.env) - Dùng cho Web, Expo Metro và Android Native
# ==============================================================================
# Copy file này thành .env trong thư mục apps/mobile:
# cp apps/mobile/.env.example apps/mobile/.env

# 1. API Endpoint
# - Dành cho Web / Điện thoại thật cắm USB (chạy kèm adb reverse):
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# - Dành cho máy ảo Android Studio (AVD): đổi thành http://10.0.2.2:3000/api/v1
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# 2. Goong Map API Keys (BẮT BUỘC để vượt qua bước kiểm tra Metro)
# Lấy từ tài khoản Goong Console (https://account.goong.io) hoặc xin owner nhóm
EXPO_PUBLIC_GOONG_API_KEY=your_goong_rest_api_key_here
EXPO_PUBLIC_GOONG_MAP_KEY=your_goong_map_key_here

