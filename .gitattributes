# Normalize line endings
* text=auto eol=lf

# Force LF for these files
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg binary
